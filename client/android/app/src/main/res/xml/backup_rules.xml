<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules for Android 6 to 11 (API 23-30), which ignore dataExtractionRules. Same
     policy as data_extraction_rules.xml: exclude all app data. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
