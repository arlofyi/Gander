<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) backup and transfer rules. Gander keeps pairing secrets (token, host
     pins, host addresses) in an encrypted store whose key lives in the Android Keystore and never
     leaves the device, so nothing from this app may be restored onto another device or from a
     cloud backup. Every app data domain is excluded from both channels. Deny by default. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
