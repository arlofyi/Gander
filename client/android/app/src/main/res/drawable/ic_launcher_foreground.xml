<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon, foreground layer: the Gander lens (a goose head in a magnifying-glass
  ring), in paper with the orange beak, on the slate background colour. Generated by hand from
  brand/gander-lens-reversed.svg: the lens is drawn in its own 100 x 100 space and the group scales
  it to 67 % and centres it so the whole mark sits inside the 66 dp safe zone of the 108 dp layer.
  The launcher mask can be a circle, squircle or rounded square; nothing important is clipped.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.67"
        android:scaleY="0.67"
        android:translateX="17.7"
        android:translateY="17.7">
        <!-- The ring and the neck. -->
        <path
            android:pathData="M44,13A31,31 0 1 1 44,75A31,31 0 1 1 44,13Z"
            android:strokeColor="#F4F2EC"
            android:strokeWidth="8" />
        <path
            android:pathData="M37.5,73.5C31,60 44,55 46.5,38"
            android:strokeColor="#F4F2EC"
            android:strokeLineCap="round"
            android:strokeWidth="9" />
        <!-- The handle: a butt start hidden inside the ring, a round end. -->
        <path
            android:pathData="M65,65L85,85"
            android:strokeColor="#F4F2EC"
            android:strokeWidth="11" />
        <path
            android:fillColor="#F4F2EC"
            android:pathData="M85,79.5A5.5,5.5 0 1 1 85,90.5A5.5,5.5 0 1 1 85,79.5Z" />
        <!-- The head, with the eye as a hole. -->
        <path
            android:fillColor="#F4F2EC"
            android:fillType="evenOdd"
            android:pathData="M56.5,33.5A9.5,9.5 0 1 0 37.5,33.5A9.5,9.5 0 1 0 56.5,33.5ZM53.4,30.7A2.2,2.2 0 1 0 49,30.7A2.2,2.2 0 1 0 53.4,30.7Z" />
        <!-- The beak, the only accent. -->
        <path
            android:fillColor="#E2682A"
            android:pathData="M54,28.5L73.5,34.5L54,39.5Z"
            android:strokeColor="#E2682A"
            android:strokeLineJoin="round"
            android:strokeWidth="1.6" />
    </group>
</vector>
