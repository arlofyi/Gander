    <string name="stream_key_ctrl">Ctrl</string>
    <string name="stream_key_alt">Alt</string>
    <string name="stream_key_shift">Shift</string>
    <string name="stream_key_esc">Esc</string>
    <string name="stream_key_tab">Tab</string>
    <string name="stream_key_enter">Enter</string>
    <string name="stream_key_backspace">Bksp</string>
    <string name="stream_key_delete">Del</string>
    <string name="stream_key_left">Left arrow</string>
    <string name="stream_key_right">Right arrow</string>
    <string name="stream_key_up">Up arrow</string>
    <string name="stream_key_down">Down arrow</string>
    <string name="stream_key_fn">Fn</string>
    <string name="stream_key_undo">Ctrl+Z</string>
    <string name="stream_key_redo">Ctrl+Y</string>
    <string name="stream_key_save">Ctrl+S</string>
    <string name="stream_key_type">Type</string>
    <string name="stream_key_system_keyboard">Keyboard</string>
    <string name="stream_key_paste_to_computer">Paste to computer</string>
    <string name="stream_key_copy_from_computer">Copy from computer</string>
    <string name="stream_text_hint">Type here, then send</string>
    <string name="stream_text_send">Send</string>

    <!-- Clipboard text (what the phone says after "Paste to computer" or "Copy from computer"; never the text itself) -->
    <string name="stream_clipboard_copied">Copied from the computer</string>
    <string name="stream_clipboard_pasted">Sent to the computer\'s clipboard</string>
    <string name="stream_clipboard_phone_empty">Nothing to send: the phone\'s clipboard has no text</string>
    <string name="stream_clipboard_computer_empty">The computer\'s clipboard has no text</string>
    <string name="stream_clipboard_too_large">That text is too long: the limit is 64 KB</string>
    <string name="stream_clipboard_disabled">The computer\'s owner has not allowed this in Gander\'s settings</string>
    <string name="stream_clipboard_locked">The computer is locked</string>
    <string name="stream_clipboard_not_active">Not now: the stream is paused, or someone is using the computer</string>
    <string name="stream_clipboard_busy">The computer\'s clipboard is busy. Try again</string>
    <string name="stream_clipboard_failed">The clipboard could not be used right now</string>
    <string name="stream_clipboard_no_answer">The computer did not answer</string>
