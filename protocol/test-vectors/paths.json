{
  "description": "Hostile and benign path vectors for the Gander path resolver. 'fixture' describes what must exist inside a temp share root before the vector runs. 'expect' is ok|reject. 'reason' is the reject code from docs/specs/2026-11-01-path-resolution.md. 'platform' is all|windows|posix. Template tokens are documented in README.md.",
  "version": 1,
  "vectors": [
    { "id": "root-empty", "input": "", "fixture": {}, "expect": "ok", "platform": "all" },
    { "id": "root-slash", "input": "/", "fixture": {}, "expect": "ok", "platform": "all" },
    { "id": "simple-file", "input": "a.txt", "fixture": { "files": ["a.txt"] }, "expect": "ok", "platform": "all" },
    { "id": "nested-file", "input": "dir/sub/a.txt", "fixture": { "files": ["dir/sub/a.txt"] }, "expect": "ok", "platform": "all" },
    { "id": "trailing-slash-dir", "input": "dir/", "fixture": { "dirs": ["dir"] }, "expect": "ok", "platform": "all" },
    { "id": "unicode-name", "input": "r\u00e9sum\u00e9 (final).pdf", "fixture": { "files": ["r\u00e9sum\u00e9 (final).pdf"] }, "expect": "ok", "platform": "all" },
    { "id": "nfd-distinct-from-nfc", "input": "re\u0301sume\u0301.txt", "fixture": { "files": ["r\u00e9sum\u00e9.txt"] }, "expect": "reject", "reason": "not_found", "platform": "all", "note": "No normalisation: an NFD request must not match an NFC file" },
    { "id": "case-insensitive-hit", "input": "README.md", "fixture": { "files": ["readme.md"] }, "expect": "ok", "platform": "windows", "note": "Case-insensitive volume resolves it; the returned name is the stored one" },
    { "id": "literal-percent-name", "input": "%2e%2e", "fixture": { "files": ["%2e%2e"] }, "expect": "ok", "platform": "all", "note": "The HTTP layer decoded once already; a literal %2e%2e is a legal file name and must NOT be treated as .." },
    { "id": "unicode-dot-leader", "input": "\u2024\u2024", "fixture": { "files": ["\u2024\u2024"] }, "expect": "ok", "platform": "all" },
    { "id": "rtl-override-name", "input": "invoice\u202eexe.pdf", "fixture": { "files": ["invoice\u202eexe.pdf"] }, "expect": "ok", "platform": "all", "note": "Resolvable; the client must render bidi controls safely" },
    { "id": "long-path-300", "input": "{{segment:'a'*100}}/{{segment:'b'*100}}/{{segment:'c'*90}}.txt", "fixture": { "files": ["{{same}}"] }, "expect": "ok", "platform": "all", "note": "Beyond MAX_PATH; must work via handle-relative opens" },
    { "id": "onedrive-placeholder", "input": "cloud.docx", "fixture": { "reparse": [{ "name": "cloud.docx", "tag": "IO_REPARSE_TAG_CLOUD" }] }, "expect": "ok", "platform": "windows", "note": "Allowed reparse class; the listing flags it cloud_only" },
    { "id": "wof-compressed", "input": "compact.bin", "fixture": { "reparse": [{ "name": "compact.bin", "tag": "IO_REPARSE_TAG_WOF" }] }, "expect": "ok", "platform": "windows" },

    { "id": "dotdot", "input": "..", "fixture": {}, "expect": "reject", "reason": "dot_segment", "platform": "all" },
    { "id": "dotdot-nested", "input": "dir/../..", "fixture": { "dirs": ["dir"] }, "expect": "reject", "reason": "dot_segment", "platform": "all" },
    { "id": "dotdot-middle-even-if-inside", "input": "dir/../dir/a.txt", "fixture": { "files": ["dir/a.txt"] }, "expect": "reject", "reason": "dot_segment", "platform": "all", "note": "No normalisation games: any .. is rejected" },
    { "id": "single-dot", "input": "./a.txt", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "dot_segment", "platform": "all" },
    { "id": "empty-segment", "input": "dir//a.txt", "fixture": { "files": ["dir/a.txt"] }, "expect": "reject", "reason": "empty_segment", "platform": "all" },
    { "id": "leading-slash-absolute", "input": "/dir/a.txt", "fixture": { "files": ["dir/a.txt"] }, "expect": "reject", "reason": "empty_segment", "platform": "all", "note": "A leading slash yields an empty first segment; the root is only '' or '/' exactly" },
    { "id": "backslash-separator", "input": "dir\\a.txt", "fixture": { "files": ["dir/a.txt"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "drive-letter", "input": "C:/Windows/win.ini", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "unc-path", "input": "\\\\server\\share\\x", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "device-path-prefix", "input": "\\\\?\\C:\\x", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "ads-data-stream", "input": "a.txt::$DATA", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "ads-named-stream", "input": "a.txt:secret", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "ads-dir-stream", "input": "dir:$I30:$INDEX_ALLOCATION", "fixture": { "dirs": ["dir"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "nul-byte", "input": "a\u0000.txt", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "control-char", "input": "a\u001f.txt", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "wildcard-star", "input": "*.txt", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "wildcard-question", "input": "a?.txt", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "angle-brackets", "input": "<a>.txt", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "pipe-char", "input": "a|b.txt", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "double-quote", "input": "a\"b.txt", "fixture": {}, "expect": "reject", "reason": "invalid_char", "platform": "all" },
    { "id": "trailing-dot", "input": "a.txt.", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "trailing_dot_or_space", "platform": "all", "note": "Windows would silently open a.txt" },
    { "id": "trailing-space", "input": "a.txt ", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "trailing_dot_or_space", "platform": "all" },
    { "id": "trailing-dot-dir", "input": "dir./a.txt", "fixture": { "files": ["dir/a.txt"] }, "expect": "reject", "reason": "trailing_dot_or_space", "platform": "all" },
    { "id": "reserved-con", "input": "CON", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "reserved-con-ext", "input": "con.txt", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "reserved-nul-lower", "input": "nul", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "reserved-com1", "input": "COM1", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "reserved-lpt9-ext", "input": "lpt9.log", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "reserved-com-superscript", "input": "COM\u00b9", "fixture": {}, "expect": "reject", "reason": "reserved_name", "platform": "all" },
    { "id": "not-reserved-con-prefix", "input": "console.log", "fixture": { "files": ["console.log"] }, "expect": "ok", "platform": "all", "note": "Only exact base-name matches are reserved" },
    { "id": "short-name-8dot3", "input": "PROGRA~1/a.txt", "fixture": { "files": ["Program Files Test/a.txt"], "note": "the fixture dir must have an 8.3 alias; skip if the volume has 8.3 names disabled" }, "expect": "reject", "reason": "short_name", "platform": "windows" },
    { "id": "short-name-literal-tilde-ok", "input": "notes~1.txt", "fixture": { "files": ["notes~1.txt"] }, "expect": "ok", "platform": "all", "note": "A tilde-digit name that really exists must resolve" },
    { "id": "invalid-utf8", "input": "{{bytes:0xC3,0x28}}.txt", "fixture": {}, "expect": "reject", "reason": "invalid_utf8", "platform": "all" },
    { "id": "overlong-utf8-dot", "input": "{{bytes:0xC0,0xAE,0xC0,0xAE}}", "fixture": {}, "expect": "reject", "reason": "invalid_utf8", "platform": "all", "note": "Overlong encoding of '..'" },
    { "id": "too-deep", "input": "{{repeat:'d/',129}}a.txt", "fixture": {}, "expect": "reject", "reason": "too_deep", "platform": "all" },
    { "id": "too-long", "input": "{{segment:'a'*4100}}", "fixture": {}, "expect": "reject", "reason": "too_long", "platform": "all" },
    { "id": "file-as-directory", "input": "a.txt/b", "fixture": { "files": ["a.txt"] }, "expect": "reject", "reason": "not_a_directory", "platform": "all" },
    { "id": "missing", "input": "nope.txt", "fixture": {}, "expect": "reject", "reason": "not_found", "platform": "all" },
    { "id": "missing-dir", "input": "nope/a.txt", "fixture": {}, "expect": "reject", "reason": "not_found", "platform": "all" },

    { "id": "symlink-file-outside", "input": "link.txt", "fixture": { "symlinks": [{ "name": "link.txt", "target": "{{outside}}/secret.txt" }] }, "expect": "reject", "reason": "reparse_point", "platform": "all", "privilege": "symlink" },
    { "id": "symlink-dir-outside", "input": "linkdir/secret.txt", "fixture": { "symlinks": [{ "name": "linkdir", "target": "{{outside}}", "dir": true }] }, "expect": "reject", "reason": "reparse_point", "platform": "all", "privilege": "symlink" },
    { "id": "symlink-inside-still-rejected", "input": "inlink/a.txt", "fixture": { "dirs": ["real"], "files": ["real/a.txt"], "symlinks": [{ "name": "inlink", "target": "{{root}}/real", "dir": true }] }, "expect": "reject", "reason": "reparse_point", "platform": "all", "privilege": "symlink", "note": "v1 policy: all links rejected, even internal ones" },
    { "id": "junction-outside", "input": "junc/secret.txt", "fixture": { "junctions": [{ "name": "junc", "target": "{{outside}}" }] }, "expect": "reject", "reason": "reparse_point", "platform": "windows" },
    { "id": "junction-nested-outside", "input": "dir/junc/secret.txt", "fixture": { "dirs": ["dir"], "junctions": [{ "name": "dir/junc", "target": "{{outside}}" }] }, "expect": "reject", "reason": "reparse_point", "platform": "windows" },
    { "id": "appexeclink", "input": "python.exe", "fixture": { "reparse": [{ "name": "python.exe", "tag": "IO_REPARSE_TAG_APPEXECLINK" }] }, "expect": "reject", "reason": "reparse_point", "platform": "windows", "privilege": "fixture-may-be-unavailable" },
    { "id": "hidden-pattern-blocks-resolve", "input": ".git/config", "fixture": { "files": [".git/config"], "share": { "hidden_patterns": [".git/**"] } }, "expect": "reject", "reason": "not_found", "platform": "all" },
    { "id": "hidden-attr-resolvable", "input": "hidden.txt", "fixture": { "files": ["hidden.txt"], "attrs": { "hidden.txt": ["hidden"] } }, "expect": "ok", "platform": "windows", "note": "Hidden files are omitted from listings by default but a direct request still resolves; the listing test covers omission" },

    { "id": "toctou-swap-after-resolve", "input": "dir/a.txt", "fixture": { "files": ["dir/a.txt"], "race": "replace 'dir' with a junction to {{outside}} after resolve returns" }, "expect": "ok", "platform": "windows", "note": "Reads MUST use the returned handle; the test reads via the handle and asserts the original content" }
  ]
}
