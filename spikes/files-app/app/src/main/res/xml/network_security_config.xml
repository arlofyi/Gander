<?xml version="1.0" encoding="utf-8"?>
<!-- Spike only: cleartext HTTP to the in-process loopback server and nothing else. The shipping
     client uses TLS with a pinned host certificate and never allows cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
