<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to open sockets, including loopback ones. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Gander Files Spike"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The documents provider the system Files app (DocumentsUI) browses. -->
        <provider
            android:name=".SpikeDocumentsProvider"
            android:authorities="fyi.arlo.gander.spike.files.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Second "video player" client: platform VideoView/MediaPlayer, started explicitly with
             `am start -n` (no VIEW filter, so the Files app resolves to the system player instead). -->
        <activity
            android:name=".PlayerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Controlled read client (sequential and random reads with chosen buffer sizes). -->
        <activity
            android:name=".ProbeActivity"
            android:exported="true" />
    </application>

</manifest>
