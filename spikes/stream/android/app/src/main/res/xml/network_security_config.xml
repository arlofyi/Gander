<?xml version="1.0" encoding="utf-8"?>
<!-- Spike only: cleartext WebSocket signalling to the host's loopback as seen from the emulator
     (10.0.2.2) or through `adb reverse` (127.0.0.1), and nothing else. The shipping client uses
     TLS with a pinned host certificate and never allows cleartext. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
