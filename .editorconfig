root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.{kt,kts,gradle,xml}]
indent_size = 4

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

# Windows-only script types keep CRLF (see .gitattributes).
[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
